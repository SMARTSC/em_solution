<Window 
    x:Class="EM.Terminal.PhotoMirror.Wind0ws.ContentHandlingConfigurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"       
    Title="Configurar Gestión de Contenidos"
    Height="370" Width="400" 
    ShowInTaskbar="False" 
    ResizeMode="NoResize" 
    WindowStartupLocation="CenterScreen"
    Loaded="Window_Loaded"
    Closing="Window_Closing">
    <Grid
        Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.ColumnSpan="2" Grid.Row="0"
            Margin="0,0,0,10"
            Header="Captura">
            <StackPanel>
                <Label Content="Cámara" />
                <ComboBox Name="CaptureDeviceComboBox" />
            </StackPanel>
        </GroupBox>
        <GroupBox 
            Grid.ColumnSpan="2" Grid.Row="1"
            Header="Entrega">
            <StackPanel>
                <Label Content="Evento" />
                <ComboBox Name="EventsComboBox" SelectionChanged="EventsComboBox_SelectionChanged" />
                <Label Content="Album" Margin="0,5,0,0" />
                <ComboBox Name="AlbumsComboBox" IsEnabled="False" />
            </StackPanel>
        </GroupBox>
        <Button 
            Grid.Column="0" Grid.Row="3"
            Margin="0,0,5,0"
            Content="Aplicar"
            IsDefault="True" 
            Click="ApplyButton_Click" />
        <Button 
            Grid.Column="1" Grid.Row="3"
            Margin="5,0,0,0" 
            Content="Cancelar"
            IsCancel="True" />
    </Grid>
</Window>
