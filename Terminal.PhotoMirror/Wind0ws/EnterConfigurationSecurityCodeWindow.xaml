<Window 
    x:Class="EM.Terminal.PhotoMirror.Wind0ws.EnterConfigurationSecurityCodeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialdesignthemes ="http://materialdesigninxaml.net/winfx/xaml/themes"
    mc:Ignorable="d"
    Title="Entre Código de Seguridad de la Configuración" 
    Height="520" Width="400" 
    ShowInTaskbar="False" 
    ResizeMode="NoResize" 
    WindowStartupLocation="CenterScreen"
    Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="CharacterButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Height" Value="60" />
            </Style>
            <Style x:Key="CharacterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}">
                <Setter Property="FontSize" Value="80" />
                <Setter Property="Height" Value="120" />
                <Setter Property="Foreground" Value="WhiteSmoke" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox
            Name="FirstCharactarCodeTextBox"
            Grid.Column="0" Grid.Row="0"
            Style="{StaticResource CharacterTextBoxStyle}"
            Margin="0,0,5,10" />
        <TextBox
            Name="SecoundCharactarCodeTextBox"
            Grid.Column="1" Grid.Row="0"
            Style="{StaticResource CharacterTextBoxStyle}"
            Margin="5,0,5,10" />
        <TextBox
            Name="ThirthCharactarCodeTextBox"
            Grid.Column="2" Grid.Row="0"
            Style="{StaticResource CharacterTextBoxStyle}"
            Margin="5,0,5,10" />
        <TextBox
            Name="LastCharactarCodeTextBox"
            Grid.Column="4" Grid.Row="0"
            Style="{StaticResource CharacterTextBoxStyle}"
            Margin="5,0,0,10" />
        <Grid
            Grid.ColumnSpan="4" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Button
                Grid.Column="0" Grid.Row="0"
                Margin="0,0,5,5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="1"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="1" Grid.Row="0"
                Margin="5,0,5,5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="2"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="2" Grid.Row="0"
                Margin="5,0,0,5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="3"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="0" Grid.Row="1"
                Margin="0,5,5,5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="4"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="1" Grid.Row="1"
                Margin="5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="5"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="2" Grid.Row="1"
                Margin="5,5,0,5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="6"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="0" Grid.Row="2"
                Margin="0,5,5,5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="7"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="1" Grid.Row="2"
                Margin="5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="8"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="2" Grid.Row="2"
                Margin="5,5,0,5"
                Style="{StaticResource CharacterButtonStyle}"
                Content="9"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.ColumnSpan="2" Grid.Row="3"
                Style="{StaticResource CharacterButtonStyle}"
                Margin="0,5,5,5"
                Content="0"
                Click="CharacterButton_Clicked" />
            <Button
                Grid.Column="2" Grid.Row="3"
                Style="{StaticResource CharacterButtonStyle}"
                Margin="5,5,0,5"
                Click="ClearButton_Clicked" >
                <materialdesignthemes:PackIcon
                    Kind="Clear" />
            </Button>
        </Grid>
        <Button 
            Grid.ColumnSpan="2" Grid.Row="2"
            Margin="0,10,5,0"
            Content="Aplicar"
            IsDefault="True"
            Click="ApplyButton_Click" />
        <Button 
            Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2"
            Margin="5,10,0,0" 
            Content="Cancelar"
            IsCancel="True" />
    </Grid>
</Window>
