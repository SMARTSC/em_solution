<Window 
    x:Class="EM.Terminal.PhotoMirror.Wind0ws.AuthenticationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Control de Acceso" 
    Height="220" Width="400"
    ShowInTaskbar="False" 
    ResizeMode="NoResize" 
    WindowStartupLocation="CenterScreen" 
    Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2" Grid.Row="0">
            <Label Content="Usuario" Margin="0,5,0,0" />
            <TextBox Name="UserLoginTextBox" />
            <Label Content="Contraseña" Margin="0,5,0,0" />
            <PasswordBox Name="UserPasswordBox" />
        </StackPanel>
        <Button Grid.Column="0" Grid.Row="1" Content="Iniciar" Margin="0,0,5,0" IsDefault="True" Click="ApplyButton_Click" />
        <Button Grid.Column="1" Grid.Row="1" Content="Cancelar" Margin="5,0,0,0" IsCancel="True"/>
    </Grid>
</Window>
