<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:EM.Terminal.Dashboard.Models.Page"
    xmlns:views="clr-namespace:EM.Terminal.Dashboard.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    mc:Ignorable="d"
    x:Class="EM.Terminal.Dashboard.Pages.AlbumConfigurationPage"
    x:TypeArguments="pagemodels:AlbumConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />

            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <views:BackgroundView />
            <ScrollView Orientation="Vertical">
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame Grid.ColumnSpan="3" Grid.Row="0">
                        <StackLayout>
                            <Label Text="Título" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Title}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.Row="1">
                        <StackLayout>
                            <Label Text="Alias" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Alias}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.Row="2">
                        <StackLayout>
                            <Label Text="Habilitado?" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsEnabled}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.Row="3"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Público?" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsPublic}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="3"
                        VerticalOptions="Start">
                        <StackLayout VerticalOptions="FillAndExpand">
                            <Label 
                                Text="Carátula" 
                                Style="{StaticResource FormLabel}" />
                            <ffimageloadingforms:CachedImage 
                                x:Name="OverlayImage"
                                Grid.ColumnSpan="2" Grid.Row="1"
                                BackgroundColor="Black"
                                Source="{Binding Path=OverlayImageSource}"
                                Aspect="AspectFill"
                                HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.5}"
                                CacheType="Disk"
                                CacheDuration="8760:00:00">
                                <ffimageloadingforms:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OverlayImageGestureRecognizer_Tapped" />
                                </ffimageloadingforms:CachedImage.GestureRecognizers>
                            </ffimageloadingforms:CachedImage>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="2" Grid.Row="4"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Platilla de Impresión para Retratos" Style="{StaticResource FormLabel}" />
                            <views:CollageLayoutView BindingContext="{Binding Path=DefaultPictureContentCollageLayout}">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PicturePrintLayoutViewGestureRecognizer_Tapped" />
                                </ContentView.GestureRecognizers>
                            </views:CollageLayoutView>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="4"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Platilla de Impresión para Sesiones de Fotos" Style="{StaticResource FormLabel}" />
                            <views:CollageLayoutView BindingContext="{Binding Path=DefaultPhotoSessionContentCollageLayout}">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PhotoSessionPrintLayoutViewGestureRecognizer_Tapped" />
                                </ContentView.GestureRecognizers>
                            </views:CollageLayoutView>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.ColumnSpan="3" Grid.Row="5">
                        <StackLayout>
                            <Label Text="Descripción" Style="{StaticResource FormLabel}" />
                            <Editor HeightRequest="180" Text="{Binding Path=Description}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <views:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>