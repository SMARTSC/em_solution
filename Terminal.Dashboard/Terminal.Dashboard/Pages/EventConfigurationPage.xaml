<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:EM.Terminal.Dashboard.Models.Page"
    xmlns:views="clr-namespace:EM.Terminal.Dashboard.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    mc:Ignorable="d"
    x:Class="EM.Terminal.Dashboard.Pages.EventConfigurationPage"
    x:TypeArguments="pagemodels:EventConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="10" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                            <On Platform="macOS" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                    <FontImageSource.Size>
                        <OnPlatform Default="16" x:TypeArguments="x:Double">
                            <On Platform="macOS" Value="10" />
                        </OnPlatform>
                    </FontImageSource.Size>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                            <On Platform="macOS" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                    <FontImageSource.Size>
                        <OnPlatform Default="16" x:TypeArguments="x:Double">
                            <On Platform="macOS" Value="10" />
                        </OnPlatform>
                    </FontImageSource.Size>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <views:BackgroundView />
            <ScrollView Orientation="Vertical">
                <Grid 
                    Padding="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame Grid.Column="0" Grid.Row="0">
                        <StackLayout>
                            <Label Text="Tipo" Style="{StaticResource FormLabel}" />
                            <Picker 
                                ItemsSource="{Binding Path=AvailableEventKinds}"
                                ItemDisplayBinding="{Binding Path=Name}"
                                SelectedItem="{Binding Path=Kind, Mode=TwoWay}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0">
                        <StackLayout>
                            <Label Text="Nombre" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Name}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.ColumnSpan="3" Grid.Row="1">
                        <StackLayout>
                            <Label Text="Lugar" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=PlaceName}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.ColumnSpan="2" Grid.Row="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Text="Fecha en que Inicia" />
                            <DatePicker 
                                Grid.Column="0" Grid.Row="1"
                                Date="{Binding Path=StartAtDate}"
                                MinimumDate="{Static x:DateTime.Now}" />
                            <TimePicker
                                Grid.Column="1" Grid.Row="1"
                                Time="{Binding Path=StartAtTime}" />
                        </Grid>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Text="Fecha en que Finaliza" />
                            <DatePicker 
                                Grid.Column="0" Grid.Row="1"
                                Date="{Binding Path=EndAtDate}"
                                MinimumDate="{Static x:DateTime.Now}" />
                            <TimePicker
                                Grid.Column="1" Grid.Row="1"
                                Time="{Binding Path=EndAtTime}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout VerticalOptions="FillAndExpand">
                            <Label 
                                Margin="10,10,10,0"
                                Text="Logo" 
                                Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickLogoImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    x:Name="LogolImage"
                                    BackgroundColor="DimGray"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width}"
                                    Source="{Binding Path=LogoImageSource}"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="Material Design Icons"
                                        Style="{StaticResource MiddleTextFontLabelStyle}" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout VerticalOptions="FillAndExpand">
                            <Label 
                                Margin="10,10,10,0"
                                Text="Carátula" 
                                Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickOverlayImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    x:Name="OverlayImage"
                                    BackgroundColor="DimGray"
                                    Source="{Binding Path=OverlayImageSource}"
                                    Aspect="AspectFill"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.5}"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="Material Design Icons"
                                        Style="{StaticResource MiddleTextFontLabelStyle}" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>                                
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.ColumnSpan="3" Grid.Row="4">
                        <StackLayout>
                            <Label Text="Descripción" Style="{StaticResource FormLabel}" />
                            <Editor HeightRequest="180" Text="{Binding Path=Description}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <views:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>