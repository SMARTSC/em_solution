<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:EM.Terminal.Dashboard.Models.Page"
    xmlns:views="clr-namespace:EM.Terminal.Dashboard.Views"
    xmlns:converters="clr-namespace:EM.Terminal.Dashboard.Converters"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    mc:Ignorable="d"
    x:Class="EM.Terminal.Dashboard.Pages.ManageEventsPage"    
    x:TypeArguments="pagemodels:ManageEventsPageModel"
    Title="Eventos">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EventDisplayModelToLogoImageSourceConverter x:Key="EventDisplayModelToLogoImageSourceConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="480" ChildAbsoluteHorizontalMargin="10" />
            <sscxftoolkitpresentationconverters:DateTimeToStringConverter x:Key="DateDateTimeToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <views:BackgroundView />
            <ScrollView Orientation="Vertical">
                <FlexLayout
                    Margin="5"
                    Wrap="Wrap"
                    AlignContent="Start" AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding Path=Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="5"
                                BackgroundColor="GhostWhite"
                                WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}"
                                HeightRequest="105">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ffimageloadingforms:CachedImage 
                                    Grid.Column="0"
                                    BackgroundColor="White"
                                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type Grid}}, Path=HeightRequest}" HeightRequest="{Binding Source={x:RelativeSource AncestorType={x:Type Grid}}, Path=HeightRequest}"
                                    Source="{Binding Converter={StaticResource EventDisplayModelToLogoImageSourceConverter}}"
                                    CacheType="None"
                                    CacheDuration="8760:00:00" />
                                <Grid
                                    Grid.Column="1"
                                    Padding="8,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Label 
                                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                        Text="{Binding Path=Name}"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource NormalTitleFontLabelStyle}" />
                                    <Label
                                        Grid.Column="0" Grid.Row="1"
                                        Text="&#xf0ed;"
                                        TextColor="{StaticResource SecundaryTextColor}"
                                        FontFamily="Material Design Icons"
                                        Style="{StaticResource MiddleTextFontLabelStyle}" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="0,2,0,0"
                                        TextColor="{StaticResource SecundaryTextColor}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} - {1}">
                                                <Binding Path="Start" Converter="{StaticResource DateDateTimeToStringConverter}" ConverterParameter="dd/MM/yyyy" />
                                                <Binding Path="End" Converter="{StaticResource DateDateTimeToStringConverter}" ConverterParameter="dd/MM/yyyy" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label
                                        Grid.Column="0" Grid.Row="2"
                                        Text="&#xf352;"
                                        TextColor="{StaticResource SecundaryTextColor}"
                                        FontFamily="Material Design Icons"
                                        Style="{StaticResource MiddleTextFontLabelStyle}" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="2"
                                        Padding="0,2,0,0"
                                        Text="{Binding Path=PlaceName}"
                                        TextColor="{StaticResource SecundaryTextColor}"
                                        LineBreakMode="WordWrap"
                                        MaxLines="2" />
                                    <Label
                                        Grid.Column="2" Grid.RowSpan="4"
                                        VerticalOptions="Start"
                                        Padding="0,6"
                                        Text="&#xf1d9;"
                                        TextColor="Accent"
                                        FontFamily="Material Design Icons"
                                        Style="{StaticResource NormalTitleFontLabelStyle}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="EventOptionsButton_Clicked" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>
        </Grid>        
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>