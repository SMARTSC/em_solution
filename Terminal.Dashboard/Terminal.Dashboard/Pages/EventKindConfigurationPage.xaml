<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:EM.Terminal.Dashboard.Models.Page"
    xmlns:views="clr-namespace:EM.Terminal.Dashboard.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    mc:Ignorable="d"
    x:Class="EM.Terminal.Dashboard.Pages.EventKindConfigurationPage"
    x:TypeArguments="pagemodels:EventKindConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="10" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                            <On Platform="macOS" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                    <FontImageSource.Size>
                        <OnPlatform Default="16" x:TypeArguments="x:Double">
                            <On Platform="macOS" Value="10" />
                        </OnPlatform>
                    </FontImageSource.Size>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Material Design Icons" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                            <On Platform="macOS" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                    <FontImageSource.Size>
                        <OnPlatform Default="16" x:TypeArguments="x:Double">
                            <On Platform="macOS" Value="10" />
                        </OnPlatform>
                    </FontImageSource.Size>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <views:BackgroundView />
            <ScrollView Orientation="Vertical">
                <Grid 
                    Padding="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Frame VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Nombre" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Name}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <views:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>