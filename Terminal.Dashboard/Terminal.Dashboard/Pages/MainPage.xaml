<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:EM.Terminal.Dashboard.Models.Page"
    xmlns:views="clr-namespace:EM.Terminal.Dashboard.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="EM.Terminal.Dashboard.Pages.MainPage"
    x:TypeArguments="pagemodels:MainPageModel"
    Title="Inicio">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--#region SSCXFToolkit.Presentation Convertes -->
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="GroupsBindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="480" ChildAbsoluteHorizontalMargin="10" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="ActiosBindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="240" ChildAbsoluteHorizontalMargin="30" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="EnabledBoolToBackgroundColorStringConverter" FalseString="DimGray" TrueString="Accent" />
            <!--#endregion-->
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <views:BackgroundView />
        <ScrollView Orientation="Vertical">
            <FlexLayout
                Padding="5"
                Wrap="Wrap"
                AlignContent="Start" AlignItems="Start"
                BindableLayout.ItemsSource="{Binding Path=ActionGroups}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <StackLayout
                            Margin="5"
                            Spacing="0"
                            WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource GroupsBindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <ContentView BackgroundColor="WhiteSmoke">
                                <Label 
                                    Margin="8,5"
                                    Text="{Binding Path=Key}"
                                    FontAttributes="Bold" />
                            </ContentView>
                            <Grid BackgroundColor="White">
                                <FlexLayout
                                    Margin="5"
                                    Wrap="Wrap"
                                    AlignContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Actions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <StackLayout
                                                Margin="5" Padding="10"
                                                BackgroundColor="{Binding Path=IsEnabled, Converter={StaticResource EnabledBoolToBackgroundColorStringConverter}}"
                                                Spacing="2"
                                                WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource ActiosBindingLayoutWidthToResponsiveChildWidthConverter}}">
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ActionView_Tapped" />
                                                </StackLayout.GestureRecognizers>
                                                <Label
                                                    HorizontalOptions="Center"
                                                    Text="{Binding Path=IconGlyph}"
                                                    TextColor="White"
                                                    FontFamily="Material Design Icons"
                                                    FontSize="48" />
                                                <Label 
                                                    HorizontalTextAlignment="Center"
                                                    Text="{Binding Path=Caption}"
                                                    TextColor="White" />
                                            </StackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>  
                                </FlexLayout>
                            </Grid>
                        </StackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>        
        <views:BusyView />
    </Grid>
</sscxftoolkitmvvmpages:BindingContextedContentPage>
