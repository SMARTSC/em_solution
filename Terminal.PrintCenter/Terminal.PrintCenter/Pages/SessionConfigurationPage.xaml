<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:CarouselPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EM.Terminal.PrintCenter.Views"
    xmlns:childpages="clr-namespace:EM.Terminal.PrintCenter.Pages.Child"
    xmlns:commonconverters="clr-namespace:EM.Terminal.Common.Converters;assembly=EM.Terminal.Common"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingformssvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="EM.Terminal.PrintCenter.Pages.SessionConfigurationPage"
    CurrentPageChanged="CarouselPage_CurrentPageChanged">
    <CarouselPage.Resources>
        <ResourceDictionary>
            <commonconverters:ImageMediaDisplayModelToThumbnailImageSourceConverter x:Key="ImageMediaDisplayModelToThumbnailImageSourceConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="10" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
        </ResourceDictionary>
    </CarouselPage.Resources>
    <childpages:UserAuthenticationChildPage Authenticated="UserAuthenticationChildPage_Authenticated" />
    <sscxftoolkitmvvmpages:ContentPage>
        <ContentPage.Content>
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <views:BackgroundView Grid.RowSpan="2" />
                <Grid
                    Grid.Row="0"
                    Padding="24"
                    BackgroundColor="{StaticResource ContrastAreaColor}">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <ffimageloadingformssvg:SvgCachedImage
                            HorizontalOptions="Center"
                            WidthRequest="80" HeightRequest="80"
                            Source="resource://EM.Terminal.PrintCenter.Assets.Vector.brand_icon.svg" />
                        <Label 
                            Text="Centro de Impresión"
                            TextColor="White"
                            FontSize="Medium" />
                        <Label
                            Text="Seleccione el Evento"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Grid>
                <ScrollView 
                    Grid.Row="1"
                    Orientation="Vertical">
                    <FlexLayout
                        Padding="5"
                        Wrap="Wrap"
                        AlignContent="Start" AlignItems="Start"
                        BindableLayout.ItemsSource="{Binding Path=ActiveEvents}">
                        <BindableLayout.EmptyView>
                            <Label 
                                Margin="10"
                                IsVisible="{Binding Path=ActiveEvents, Converter={StaticResource NotNullToBooleanConverter}}"
                                Text="Sin elementos que mostrar"
                                HorizontalTextAlignment="Center" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="5"
                                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="EventOverviewGestureRecognizer_Tapped" />
                                    </Grid.GestureRecognizers>
                                    <ffimageloadingforms:CachedImage 
                                        BackgroundColor="Black"
                                        HeightRequest="{Binding Source={x:RelativeSource AncestorType={x:Type Grid}}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.5}"
                                        Source="{Binding Path=Overlay, Converter={StaticResource ImageMediaDisplayModelToThumbnailImageSourceConverter}}"
                                        Aspect="AspectFill"
                                        CacheType="Disk"
                                        CacheDuration="8760:00:00" />
                                    <Label 
                                        VerticalOptions="End"
                                        BackgroundColor="#88000000"
                                        Padding="10,6"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Path=Kind.Name}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Path=Name}" />
                                            </FormattedString>
                                        </Label.FormattedText>    
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
                <views:BusyView Grid.Row="1" />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <sscxftoolkitmvvmpages:ContentPage>
        <ContentPage.Content>
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <views:BackgroundView Grid.RowSpan="2" />
                <Grid
                    Grid.Row="0"
                    Padding="24"
                    BackgroundColor="{StaticResource ContrastAreaColor}">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <ffimageloadingformssvg:SvgCachedImage
                            HorizontalOptions="Center"
                            WidthRequest="80" HeightRequest="80"
                            Source="resource://EM.Terminal.PrintCenter.Assets.Vector.brand_icon.svg" />
                        <Label 
                            Text="Centro de Impresión"
                            TextColor="White"
                            FontSize="Medium" />
                        <Label
                            Text="Seleccione el Album"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Grid>
                <ScrollView 
                    Grid.Row="1"
                    Orientation="Vertical">
                    <FlexLayout
                        Margin="5"
                        Wrap="Wrap"
                        AlignContent="Start" AlignItems="Start"
                        BindableLayout.ItemsSource="{Binding Path=TargetEvent.Albums}">
                        <BindableLayout.EmptyView>
                            <Label 
                                Margin="10"
                                Text="Cargando ..."
                                HorizontalTextAlignment="Center" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="5"
                                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="AlbumOverviewGestureRecognizer_Tapped" />
                                    </Grid.GestureRecognizers>
                                    <ffimageloadingforms:CachedImage 
                                        BackgroundColor="Black"
                                        HeightRequest="{Binding Source={x:RelativeSource AncestorType={x:Type Grid}}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.5}"
                                        Source="{Binding Path=Overlay, Converter={StaticResource ImageMediaDisplayModelToThumbnailImageSourceConverter}}"
                                        Aspect="AspectFill"
                                        CacheType="Disk"
                                        CacheDuration="8760:00:00" />
                                    <Label 
                                        VerticalOptions="End"
                                        BackgroundColor="#88000000"
                                        Padding="10,6"
                                        Text="{Binding Path=Title}"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
                <views:BusyView Grid.Row="1" />
            </Grid>
        </ContentPage.Content>
    </sscxftoolkitmvvmpages:ContentPage>
    <childpages:PrintCloudConnectChildPage />
</sscxftoolkitmvvmpages:CarouselPage>