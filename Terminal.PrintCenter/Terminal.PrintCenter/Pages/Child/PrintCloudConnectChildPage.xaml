<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:childpagemodels="clr-namespace:EM.Terminal.PrintCenter.Models.Page.Child"
    xmlns:views="clr-namespace:EM.Terminal.PrintCenter.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingformssvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="EM.Terminal.PrintCenter.Pages.Child.PrintCloudConnectChildPage"
    x:TypeArguments="childpagemodels:PrintCloudConnectChildPageModel"
    IsEnabled="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <views:BackgroundView Grid.RowSpan="2" />
            <Grid
                Grid.Row="0"
                Padding="24"
                BackgroundColor="{StaticResource ContrastAreaColor}">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <ffimageloadingformssvg:SvgCachedImage
                        HorizontalOptions="Center"
                        WidthRequest="80" HeightRequest="80"
                        Source="resource://EM.Terminal.PrintCenter.Assets.Vector.brand_icon.svg" />
                    <Label 
                        Text="Centro de Impresión"
                        TextColor="White"
                        FontSize="Medium" />
                    <Label
                        Text="Servidor de Impresión"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />
                </StackLayout>
            </Grid>
            <Grid
                Grid.Row="1"
                WidthRequest="320"
                HorizontalOptions="Center" VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Entry
                    Grid.ColumnSpan="3" Grid.Row="0"
                    Text="{Binding Path=Host}"
                    Placeholder="dirección" />
                <Entry
                    Grid.Column="0" Grid.Row="1"
                    Text="{Binding Path=Port}"
                    Placeholder="puerto"
                    Keyboard="Numeric" />
                <Label
                    Grid.Column="1" Grid.Row="1"
                    VerticalOptions="Center"
                    Text="Enlace Protegido?"
                    HorizontalTextAlignment="End" />
                <Switch
                    Grid.Column="2" Grid.Row="1"
                    IsToggled="{Binding Path=IsSecure}" />
                <Button
                    Grid.ColumnSpan="3" Grid.Row="2"
                    Margin="0,10,0,0"
                    HorizontalOptions="FillAndExpand"
                    BackgroundColor="Accent"
                    HeightRequest="36"
                    Text="Comprobar"
                    TextColor="White"
                    Clicked="CheckButton_Clicked" />
            </Grid>
            <views:BusyView Grid.Row="1" />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>