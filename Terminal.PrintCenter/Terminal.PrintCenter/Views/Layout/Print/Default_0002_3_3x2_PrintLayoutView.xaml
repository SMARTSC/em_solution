<?xml version="1.0" encoding="UTF-8"?>
<printlayoutviews:BasePhotoSessionContentPrintLayoutView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:printlayoutviews="clr-namespace:EM.Terminal.PrintCenter.Views.Layout.Print"
    xmlns:ffimageloadingformsviews="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="EM.Terminal.PrintCenter.Views.Layout.Print.Default_0002_3_3x2_PrintLayoutView"
    BackgroundColor="White">
    <ContentView.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" />
                <ColumnDefinition />
                <ColumnDefinition Width="0.1*" />
                <ColumnDefinition />
                <ColumnDefinition Width="0.1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*" />
                <RowDefinition />
                <RowDefinition Height="0.1*" />
                <RowDefinition />
                <RowDefinition Height="0.1*" />
            </Grid.RowDefinitions>
            <ffimageloadingformsviews:CachedImage
                x:Name="FirstPhotoSessionContentImage"
                Grid.Column="1" Grid.Row="1"
                Aspect="AspectFit"
                CacheType="Disk"
                CacheDuration="8760:00:00"
                Success="CachedImage_Success"
                Error="CachedImage_Error" />
            <ffimageloadingformsviews:CachedImage
                x:Name="SecoundPhotoSessionContentImage" 
                Grid.Column="1" Grid.Row="3"
                Aspect="AspectFit"
                CacheType="Disk"
                CacheDuration="8760:00:00"
                Success="CachedImage_Success"
                Error="CachedImage_Error" />
            <ffimageloadingformsviews:CachedImage
                x:Name="ThirdPhotoSessionContentImage" 
                Grid.Column="3" Grid.Row="1"
                Aspect="AspectFit"
                CacheType="Disk"
                CacheDuration="8760:00:00"
                Success="CachedImage_Success"
                Error="CachedImage_Error" />
            <Grid Grid.Column="3" Grid.Row="3">
                <Grid ColumnSpacing="0" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="0.2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.2*" />
                        <RowDefinition />
                        <RowDefinition Height="0.2*" />
                    </Grid.RowDefinitions>
                    <ffimageloadingformsviews:CachedImage
                        x:Name="EventLogoImage"
                        Grid.Column="1" Grid.Row="1"
                        CacheType="Disk"
                        CacheDuration="8760:00:00"
                        WidthRequest="{Binding Source={x:Reference EventLogoImage}, Path=Height}" />
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</printlayoutviews:BasePhotoSessionContentPrintLayoutView>