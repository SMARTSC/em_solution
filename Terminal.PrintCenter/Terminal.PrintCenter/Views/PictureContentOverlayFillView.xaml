<?xml version="1.0" encoding="UTF-8"?>
<ContentView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:EM.Terminal.PrintCenter.Converters"
    xmlns:ffimageloadingformsviews="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="EM.Terminal.PrintCenter.Views.PictureContentOverlayFillView"
    BackgroundColor="CadetBlue">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:PictureContentDisplayModelToThumbnailImageSourceConverter x:Key="PictureContentDisplayModelToThumbnailImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <ffimageloadingformsviews:CachedImage
            BackgroundColor="Black"
            Source="{Binding Converter={StaticResource PictureContentDisplayModelToThumbnailImageSourceConverter}}"
            CacheType="Disk"
            CacheDuration="8760:00:00" />
    </ContentView.Content>
</ContentView>