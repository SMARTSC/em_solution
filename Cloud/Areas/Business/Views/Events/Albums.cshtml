@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;
@using EM.Cloud.Models.View;

@model EventAlbumsViewModel

@{
    ViewData["Title"] = "Modificar Evento (Albumes)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Eventos",
            Url = Url.Action("index", "events", new { key = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        dd {
            margin-bottom: 0;
        }
    </style>
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>Modificar Cuenta</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" asp-action="edit" asp-route-key="@Model.Event.Id">Datos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Albumes</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="card" style="margin-bottom: 20px;">
            <div class="card-body">
                <h4>Evento</h4>
                <hr />
                <div class="row">
                    <dl class="col-md-12">
                        <dt>Nombre</dt>
                        <dd>@Html.DisplayFor(model => model.Event.Name)</dd>
                    </dl>
                    <dl class="col-md-6">
                        <dt>Comienza</dt>
                        <dd>@Html.DisplayFor(model => model.Event.Start)</dd>
                    </dl>
                    <dl class="col-md-6">
                        <dt>Termina</dt>
                        <dd>@Html.DisplayFor(model => model.Event.End)</dd>
                    </dl>
                    <dl class="col-md-6 mb-md-0">
                        <dt>Descripción</dt>
                        <dd>@Html.Raw(Model.Event.Descrition ?? "-")</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Anotaciones</dt>
                        <dd>@Html.Raw(Model.Event.Annotations ?? "-")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-4">
                @*@Html.Partial("_CountriesFilterPartial", Model.Filter)*@
            </div>
            <div class="col-sm-8">
                <a class="btn btn-primary float-right" href="#" data-toggle="modal" data-target="#add-album">Agregar</a>
            </div>
        </div>

        @await Html.PartialAsync("_CreateAlbumPartial", new AlbumInputViewModel
        {
            EventId = Model.Event.Id,
            DefaultPictureContentCollageLayoutSelectListItems = Model.DefaultPictureContentCollageLayoutSelectListItems,
            DefaultPhotoSessionContentCollageLayoutSelectListItems = Model.DefaultPhotoSessionContentCollageLayoutSelectListItems
        })

        <table class="table mb-0">
            <thead>
                <tr>
                    <th>@GlobalViewLocalizationHelper.Localize("Title")</th>
                    <th style="width: 1px; white-space: nowrap;">@GlobalViewLocalizationHelper.Localize("Enabled")</th>
                    <th style="width: 1px; white-space: nowrap;">@GlobalViewLocalizationHelper.Localize("Public")</th>
                    <th style="width: 1px; white-space: nowrap;">Sesiones</th>
                    <th style="width: 1px; white-space: nowrap;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Albums.Count > 0)
                {
                    @foreach (var item in Model.Albums)
                    {
                        item.Event = Model.Event;

                        <tr>
                            <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Title")">@item.Title</td>
                            <td style="vertical-align: middle; text-align: center;" title="@GlobalViewLocalizationHelper.Localize("Enabled")">
                                @if (item.Enabled)
                                {<span class="far fa-check-square"></span> }
                                else
                                { <span class="far fa-square"></span>}
                            </td>
                            <td style="vertical-align: middle; text-align: center;" title="@GlobalViewLocalizationHelper.Localize("Public")">
                                @if (item.Public)
                                {<span class="far fa-check-square"></span> }
                                else
                                { <span class="far fa-square"></span>}
                            </td>
                            <td style="vertical-align: middle; width: 1px; white-space: nowrap;" title="@GlobalViewLocalizationHelper.Localize("PhotoSessionCaptureCount")">@item.PhotoSessionCaptureCount capturas</td>
                            <td style="vertical-align: middle;">
                                <div class="btn-group btn-group-sm">
                                    <a role="button" class="btn btn-light" asp-action="albumedit" asp-route-eventId="@Model.Event.Id" asp-route-albumId="@item.Id"><span class="fas fa-edit"></span> Editar</a>
                                    <a role="button" class="btn btn-light" asp-action="albumpicturecontents" asp-route-eventkey="@Model.Event.Id" asp-route-albumkey="@item.Id"><span class="fas fa-folder-open"></span> Contenidos</a>
                                    <a role="button" href="#" class="btn btn-danger" data-toggle="modal" data-target="#delete-album-@item.Id"><span class="fas fa-trash"></span> Eliminar</a>
                                </div>
                            </td>
                        </tr>

                        @await Html.PartialAsync("_DeleteAlbumPartial", item)
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a class="btn btn-light" asp-action="index">Regresar al listado</a>
    </div>
</div>