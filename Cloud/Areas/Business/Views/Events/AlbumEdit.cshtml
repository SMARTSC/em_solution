@model EM.Cloud.Models.View.AlbumInputViewModel

@{
    ViewData["Title"] = "Editar Album";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Eventos",
            Url = Url.Action("index", "events", new { key = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Albumes",
            Url = Url.Action("albums", "events", new { key = Model.EventId })
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("editalbum", "events", null, FormMethod.Post, true, null))
{
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Datos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="editalbumlocks" asp-route-eventId="@Model.EventId" asp-route-albumId="@Model.Id">Accesos</a>
                </li>
            </ul>
        </div>

        <div class="card-body">
            @Html.HiddenFor(model => model.Id)

            @Html.HiddenFor(model => model.EventId)

            <div class="row">
                <div class="col-md-8" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Title, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Title, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-4" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Alias, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Alias, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Alias, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-3" style="margin-bottom: 20px;">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) Enabled?
                            @Html.ValidationMessageFor(model => model.Enabled)
                        </label>
                    </div>
                </div>
                <div class="col-md-3" style="margin-bottom: 20px;">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Public) Public?
                            @Html.ValidationMessageFor(model => model.Public)
                        </label>
                    </div>
                </div>
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.PhotoSessionCaptureCount, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.PhotoSessionCaptureCount, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.PhotoSessionCaptureCount, null, new { @class = "text-danger" })
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.DefaultPictureContentCollageLayoutId, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.DefaultPictureContentCollageLayoutId, Model.DefaultPictureContentCollageLayoutSelectListItems, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.DefaultPictureContentCollageLayoutId, null, new { @class = "text-danger" })
            </div>

            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.DefaultPhotoSessionContentCollageLayoutId, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.DefaultPhotoSessionContentCollageLayoutId, Model.DefaultPhotoSessionContentCollageLayoutSelectListItems, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.DefaultPhotoSessionContentCollageLayoutId, null, new { @class = "text-danger" })
            </div>

            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" asp-action="albums" asp-route-key="@Model.EventId">Regresar al listado de Albumes</a>
            <a class="btn btn-light" asp-action="index">Regresar al listado de Eventos</a>
        </div>
    </div>
}
