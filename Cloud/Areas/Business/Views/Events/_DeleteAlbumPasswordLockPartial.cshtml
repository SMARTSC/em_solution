@model EM.Cloud.Models.View.AlbumPasswordLockInputViewModel

<div class="modal fade" id="delete-album-lock-password-@EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-album-lock-password-@EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID-title">Eliminar Acceso a Album con Contraseña</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("deletealbumpasswordlock", "events", null, FormMethod.Post, true, null))
            {
                <div class="modal-body">
                    @Html.HiddenFor(model => model.AlbumId)
                    @Html.HiddenFor(model => model.EventId)

                    <p>Está seguro que desea eliminar el acceso a album con contraseña?</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
