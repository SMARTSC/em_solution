@using SmartSolucionesCuba.SAPRESSC.Core.Common.Models.View;
@using EM.Cloud.Models.View;

@model EventAlbumLocksViewModel

@{
    ViewData["Title"] = "Editar Album (Accesos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Eventos",
            Url = Url.Action("index", "events", new { key = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Albumes",
            Url = Url.Action("albums", "events", new { key = Model.Album.Event.Id })
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";

    var hasPasswordLock = Model.Locks.Any(item => item.Descriptor.Id == EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID);
}

@section styles {
    <style type="text/css">
        dd {
            margin-bottom: 0;
        }
    </style>
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>Editar Album</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" asp-action="albumedit" asp-route-eventId="@Model.Album.Event.Id" asp-route-albumId="@Model.Album.Id">Datos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Accesos</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="row mb-2">
            <div class="col-sm-4"></div>
            <div class="col-sm-8">
                @if (!hasPasswordLock)
                {
                    <div class="btn-group mb-2 float-right">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">Agregar</button>
                        <div class="dropdown-menu dropdown-menu-right">
                            @if (!hasPasswordLock)
                            {
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#add-album-lock-password">@GlobalViewLocalizationHelper.Localize("Password", ViewLocalizer)</a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!hasPasswordLock)
        {
            @await Html.PartialAsync("_CreateAlbumPasswordLockPartial", new AlbumPasswordLockInputViewModel
            {
                EventId = Model.Album.Event.Id,
                AlbumId = Model.Album.Id
            })
        }

        <table class="table mb-0">
            <thead>
                <tr>
                    <th>@GlobalViewLocalizationHelper.Localize("Name")</th>
                    <th>@GlobalViewLocalizationHelper.Localize("Description")</th>
                    <th style="width: 1px; white-space: nowrap;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Locks.Count > 0)
                {
                    @foreach (var item in Model.Locks)
                    {
                        <tr>
                            <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Name")">@item.Descriptor.Name</td>
                            <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Description")">@item.Descriptor.Description</td>
                            <td style="vertical-align: middle;">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Descriptor.Id == EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID)
                                    {
                                        <a role="button" href="#" class="btn btn-light" data-toggle="modal" data-target="#overview-album-lock-password-@item.Descriptor.Id"><span class="fas fa-eye"></span> Mostrar</a>
                                        <a role="button" href="#" class="btn btn-light" data-toggle="modal" data-target="#edit-album-lock-password-@item.Descriptor.Id"><span class="fas fa-edit"></span> Editar</a>
                                        <a role="button" href="#" class="btn btn-danger" data-toggle="modal" data-target="#delete-album-lock-password-@item.Descriptor.Id"><span class="fas fa-trash"></span> Eliminar</a>
                                    }
                                </div>

                                @if (item.Descriptor.Id == EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID)
                                {
                                    var modelInput = new EM.Cloud.Models.View.AlbumPasswordLockInputViewModel
                                    {
                                        AlbumId = Model.Album.Id,
                                        EventId = Model.Album.Event.Id,
                                        Password = item.SerializedContext
                                    };

                                    @await Html.PartialAsync("_EditAlbumPasswordLockPartial", modelInput)
                                    @await Html.PartialAsync("_DeleteAlbumPasswordLockPartial", modelInput)

                                    <div class="modal fade" id="overview-album-lock-password-@EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID" tabindex="-1" role="dialog" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="overview-album-lock-password-@EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID-title">Acceso a Album con Contraseña</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <div>
                                                        <img class="text-center" src="@Url.Action("albumlockqr", "image", new { albumId = Model.Album.Id, lockId = EM.Extend.Lock.Pioneer.Descriptors.PasswordAlbumLockDescriptor.ID })" />
                                                    </div>
                                                    <dl class="mb-0">
                                                        <dt>ID de Album</dt>
                                                        <dd>@Model.Album.Id</dd>
                                                        <dt>Alias de Album</dt>
                                                        <dd>@Model.Album.Alias</dd>
                                                        <dt>Contraseña</dt>
                                                        <dd>@item.SerializedContext</dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a class="btn btn-light" asp-action="albums" asp-route-key="@Model.Album.Event.Id">Regresar al listado de Albumes</a>
        <a class="btn btn-light" asp-action="index">Regresar al listado de Eventos</a>
    </div>
</div>