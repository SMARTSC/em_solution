            <div class="row">
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.Start, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Start, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.Start, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6" style="margin-bottom: 20px;">
                    @Html.LabelFor(model => model.End, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.End, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.End, null, new { @class = "text-danger" })
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Descrition, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Descrition, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Descrition, null, new { @class = "text-danger" })
            </div>

            <div>
                @Html.LabelFor(model => model.Annotations, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Annotations, 3, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Annotations, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-default" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}