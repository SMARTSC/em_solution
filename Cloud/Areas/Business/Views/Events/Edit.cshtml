@using (Html.BeginForm("edit", "events", new { Area = "business", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4>Modificar Evento</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Datos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="albums" asp-route-key="@Model.Id">Albumes</a>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-6" style="margin-bottom: 20px;">
                    <div class="card">
                        <img src="@Url.Action("image", "media", new { Area = "business", key = Model.LogoId })" class="card-img-top" id="LogoFilePreview" />
                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.LogoFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.LogoFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-lg-9 col-md-8 col-sm-6" style="margin-bottom: 20px;">
                    <div style="margin-bottom: 20px;">
                        @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                    </div>
                    <div>
                        @Html.LabelFor(model => model.PlaceName, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.PlaceName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.PlaceName, null, new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            @*<div class="row">
                <div class="col-sm-4" style="margin-bottom: 20px;">
