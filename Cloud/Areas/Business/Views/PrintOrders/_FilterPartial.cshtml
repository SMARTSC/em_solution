@model EM.Cloud.Models.Filter.PrintOrderFilterModel

@using (Html.BeginForm("filter", "printorders", new { Area = "business" }, FormMethod.Post, true, null))
{
    <div class="card">
        <div class="card-header">Filtro del Listado</div>
        <div class="card-body">
            @Html.LabelFor(model => model.CompletitionState, new { @class = "control-label" })
            <div class="row">
                <div class="col-sm-4" style=" margin-bottom: 20px;">
                    <div class="custom-radio">
                        <label>
                            @Html.RadioButtonFor(model => model.CompletitionState, EM.Cloud.Models.Filter.CompletitionStateFilteringOption.Eny, new { @checked = Model.CompletitionState == EM.Cloud.Models.Filter.CompletitionStateFilteringOption.Eny }) @GlobalViewLocalizationHelper.Localize("Eny")
                        </label>
                    </div>
                </div>
                <div class="col-sm-4" style=" margin-bottom: 20px;">
                    <div class="custom-radio">
                        <label>
                            @Html.RadioButtonFor(model => model.CompletitionState, EM.Cloud.Models.Filter.CompletitionStateFilteringOption.Attended, new { @checked = Model.CompletitionState == EM.Cloud.Models.Filter.CompletitionStateFilteringOption.Attended }) @GlobalViewLocalizationHelper.Localize("Attended")
                        </label>
                    </div>
                </div>
                <div class="col-sm-4" style=" margin-bottom: 20px;">
                    <div class="custom-radio">
                        <label>
                            @Html.RadioButtonFor(model => model.CompletitionState, EM.Cloud.Models.Filter.CompletitionStateFilteringOption.Unattended, new { @checked = Model.CompletitionState == EM.Cloud.Models.Filter.CompletitionStateFilteringOption.Unattended }) @GlobalViewLocalizationHelper.Localize("Unattended")
                        </label>
                    </div>
                </div>
            </div>

            @Html.LabelFor(model => model.EnabledState, new { @class = "control-label" })
            <div class="row">
                <div class="col-sm-4" style=" margin-bottom: 20px;">
                    <div class="custom-radio">
                        <label>
                            @Html.RadioButtonFor(model => model.EnabledState, EM.Cloud.Models.Filter.EnabledStateFilteringOption.Eny, new { @checked = Model.EnabledState == EM.Cloud.Models.Filter.EnabledStateFilteringOption.Eny }) @GlobalViewLocalizationHelper.Localize("Eny")
                        </label>
                    </div>
                </div>
                <div class="col-sm-4" style=" margin-bottom: 20px;">
                    <div class="custom-radio">
                        <label>
                            @Html.RadioButtonFor(model => model.EnabledState, EM.Cloud.Models.Filter.EnabledStateFilteringOption.Enabled, new { @checked = Model.EnabledState == EM.Cloud.Models.Filter.EnabledStateFilteringOption.Enabled }) @GlobalViewLocalizationHelper.Localize("Enabled")
                        </label>
                    </div>
                </div>
                <div class="col-sm-4" style=" margin-bottom: 20px;">
                    <div class="custom-radio">
                        <label>
                            @Html.RadioButtonFor(model => model.EnabledState, EM.Cloud.Models.Filter.EnabledStateFilteringOption.Disabled, new { @checked = Model.EnabledState == EM.Cloud.Models.Filter.EnabledStateFilteringOption.Disabled }) @GlobalViewLocalizationHelper.Localize("Disabled")
                        </label>
                    </div>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-filter"></span> Filtrar</button>
                <button type="button" class="btn btn-light filter-form-reseter"><span class="glyphicon glyphicon-remove-circle"></span> Limpiar</button>
            </div>
        </div>
    </div>
}