@model SmartSolucionesCuba.SAPRESSC.Core.Web.Frontend.Models.View.PaginationViewModel<EM.Cloud.Persistence.Entities.PrintOrder, long, EM.Cloud.Models.View.PrintOrderDisplayViewModel>

@{
    ViewData["Title"] = "Administración de Órdenes de Impresión";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"fas fa-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section scripts {
    <script type="text/javascript">
        $("#overview-modal").on("show.bs.modal", function (e) {
            var link = $(e.relatedTarget);

            var modal = $(this);

            var modalBody = modal.find(".modal-body");

            modalBody.load(link.data("href"));
        });

        $('#overview-modal').on('hidden.bs.modal', function (e) {
            var modal = $(this);

            var modalBody = modal.find(".modal-body");

            modalBody.html('<div style="text-align: center;"><span class="text-muted">Cargando ...</span></div>');
        })
    </script>
}

<div class="row" style="margin-bottom: 20px;">
    <div class="col-sm-6">
        @await Html.PartialAsync("_FilterPartial", Model.Filter ?? new EM.Cloud.Models.Filter.PrintOrderFilterModel())
    </div>
    <div class="col-sm-6">
        <table class="m-1" style="width: 100%; margin-bottom: 20px;">
            <tr>
                <td style="text-align: right; vertical-align: central; font-size: 28px;">Cola de Impresión</td>
                <td style="vertical-align: central; width: 1px; word-wrap: unset; font-size: 28px !important;">@await Component.InvokeAsync("PrintOrderStackState")</td>
            </tr>
        </table>
        <div style="margin-bottom: 20px; text-align: right;">
            <a role="button" href="#" class="btn btn-danger" data-toggle="modal" data-target="#delete-pendings"><span class="fas fa-trash-alt"></span> Eliminar Pendientes</a>

            <div class="modal fade" id="delete-pendings" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="text-align: left;">
                        @using (Html.BeginForm("deletependings", "printorders", new { Area = "business" }, FormMethod.Post, true, null))
                        {
                            <div class="modal-header">
                                <h5 class="modal-title" id="delete-pendings-title">Eliminar Pendientes</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body">
                                <p>Está seguro que desea eliminar todas las ordenes de impresión pendientes?</p>
                            </div>

                            <div class="modal-footer" style="margin-top: 0;">
                                <button type="submit" class="btn btn-danger">Eliminar</button>
                                <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="clearfix" style="margin-bottom: 20px;"></div>

@if (Model.MaxPageCount > 0)
{
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = paginationStart - 1 + Model.List.Count;

        <div class="text-center">
            <ul class="pagination" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&raquo;</a></li>
                }
            </ul>
            <div class="text-info" style="margin-top: 10px; margin-bottom: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
        </div>
    }

        <div style="border: 1px solid #DDD; border-radius: 4px; margin-bottom: 20px;">
            <table class="table" style="margin: 0;">
                <thead>
                    <tr>
                        <th style="width: 1px; word-wrap: unset;">Id</th>
                        <th style="width: 1px; word-wrap: unset;">Habilitado?</th>
                        <th style="width: 1px; word-wrap: unset;">Copias</th>
                        <th>Creada</th>
                        <th>Atendida</th>
                        <th style="width: 184px;">Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.List)
                    {
                        <tr>
                            <td style="vertical-align: middle;" title="Identificador">@item.Id</td>
                            <td style="vertical-align: middle; text-align: center;" title="Habilitado?">
                                @using (Html.BeginForm(item.Enabled ? "disable" : "enable", "printorders", new { Area = "business" }, FormMethod.Post, true, null))
                                {
                                    <input type="hidden" name="key" value="@Html.Raw(item.Id)" />

                                    <button type="submit" class="btn btn-link">
                                        @if (item.Enabled)
                                        {<span class="far fa-check-square"></span> }
                                        else
                                        { <span class="far fa-square"></span>}
                                    </button>
                                }
                            </td>
                            <td style="vertical-align: middle; text-align: right;" title="Copias">@item.Count</td>
                            <td style="vertical-align: middle;" title="Creada">@item.Created.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="vertical-align: middle;" title="Atendida">@if (item.Attended == System.DateTime.MinValue)
                            {<span>-</span> }
                            else
                            { @item.Attended.ToString("dd/MM/yyyy HH:mm")}</td>
                            <td style="vertical-align: middle;">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-light" data-toggle="modal" data-target="#overview-modal" data-href="@Url.Action("overview", new { key = item.Id })"><span class="fas fa-eye"></span> Vistazo</a>
                                    <a role="button" href="@Url.Action("delete", new {key = item.Id})" class="btn btn-danger"><span class="fas fa-trash-alt"></span> Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="modal fade" id="overview-modal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="overview-modal-label">Vistazo de Orden de Impresión</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div style="text-align: center;"><span class="text-muted">Cargando ...</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    if (Model.HasNext || Model.HasPrevious)
    {
        var paginationStart = (Model.Page - 1) * Model.Limit + 1;
        var paginationEnd = Model.List.Count;

        <div class="text-center" style="margin-bottom: 20px;">
            <div class="text-info" style="margin-bottom: 10px; margin-top: 20px;">
                <span style="font-weight: 600;">Página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
            </div>
            <ul class="pagination" style="margin: 0;">
                @if (Model.HasPrevious)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"key", Model.Page - 1}})">&laquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&laquo;</a></li>
                }

                @if (Model.MaxPageCount > 5)
                {
                    if (Model.Page > 3)
                    {
                        if (Model.MaxPageCount - Model.Page < 3)
                        {
                            for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"key", i}})">@i</a></li>
                                }
                            }
                        }
                        else
                        {
                            for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"key", i}})">@i</a></li>
                                }
                            }
                        }
                    }
                    else
                    {
                        for (var i = 1; i <= 5; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"key", i}})">@i</a></li>
                            }
                        }
                    }
                }
                else
                {
                    for (var i = 1; i <= Model.MaxPageCount; i++)
                    {
                        if (i == Model.Page)
                        {
                            <li class="active"><a href="#">@i <span class="sr-only">(current)</span></a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"key", i}})">@i</a></li>
                        }
                    }
                }

                @if (Model.HasNext)
                {
                    <li><a href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"key", Model.Page + 1}})">&raquo;</a></li>
                }
                else
                {
                    <li class="disabled"><a href="#">&raquo;</a></li>
                }
            </ul>
        </div>
    }
}
else
{
    <div style="border: 1px solid #DDD; border-radius: 4px; margin-bottom: 20px;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Creada</th>
                    <th>Atendida</th>
                    <th>Habilitado?</th>
                    <th>Copias</th>
                    <th style="width: 184px;">Opciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="6"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                </tr>
            </tbody>
        </table>
    </div>
}

