@model EM.Cloud.Models.View.ExtendedPrintOrderDisplayViewModel

<div class="row">
    <div class="col-sm-6">
        <img class="img-fluid img-thumbnail" src="data:image/jpeg;base64,@Model.Base64ImageData" />
    </div>
    <div class="col-sm-6">
        <dl>
            <dt>Creada</dt>
            <dd>@Model.Created.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt>Atentida</dt>
            <dd>@if (Model.Attended == System.DateTime.MinValue)
            {<span>-</span> }
            else
            { @Model.Attended.ToString("dd/MM/yyyy HH:mm")}</dd>
            <dt>Copias</dt>
            <dd>@Model.Count</dd>
            <dt>Habilitada?</dt>
            <dd>@if (Model.Enabled)
            {<span>Si</span> }
            else
            { <span>No</span>}</dd>
        </dl>
    </div>
</div>